# PostgreSQL Connection Credentials
POSTGRES_USER=user
POSTGRES_PASSWORD=user1234
POSTGRES_DB=mydb
TZ=Africa/Addis_Ababa

# Prisma Database URL
DATABASE_URL="postgresql://user:user1234@localhost:5432/mydb?schema=public"

# Application Secrets & Settings
PORT=3000
EITA_BOT_MODE=webhook # Eitaa currently uses webhook delivery in this adapter
EITA_BOT_TOKEN=
EITA_API_ROOT=https://eitaayar.ir/api
EITA_WEBHOOK_SECRET= # optional shared secret; configure matching header at webhook sender
EITA_WEBHOOK_URL=https://your-domain.example/api/eita/webhook
MINI_APP_URL="https://grow-hekggrmnr-deepblue-dots-projects.vercel.app/miniapp"
JWT_SECRET="growbot_secret_key"
